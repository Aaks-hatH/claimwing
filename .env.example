# ---------- Required ----------
# MongoDB connection string (MongoDB Atlas free tier works). Photos are stored here too (GridFS).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/claimwing?retryWrites=true&w=majority
# Random secret for signing sessions. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Public URL of the app (used for OAuth callbacks). Locally: http://localhost:3000
AUTH_URL=http://localhost:3000

# ---------- Sign-in with Google (optional) ----------
# Redirect URI to register: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------- Flight schedule and actual times (strongly recommended) ----------
# AeroDataBox via RapidAPI: scheduled, revised (actual) and runway times + aircraft transponder code.
AERODATABOX_RAPIDAPI_KEY=
# AERODATABOX_RAPIDAPI_HOST=aerodatabox.p.rapidapi.com
# Alternative: AviationStack (free plan is HTTP only and has a small monthly quota).
AVIATIONSTACK_KEY=
# AVIATIONSTACK_BASE_URL=http://api.aviationstack.com/v1
# Force a provider: aerodatabox | aviationstack | none. Default: whichever key is set.
SCHEDULE_PROVIDER=
# Minimum seconds between schedule API calls per flight while it is active (protects your quota).
SCHEDULE_TTL_SECONDS=600

# ---------- Live aircraft positions (ADS-B) ----------
# airplanes.live needs no key (1 request/second, non-commercial). OpenSky is the fallback.
# OpenSky API client (optional, raises the daily quota from 400 to 4,000 credits): opensky-network.org > Account > API client
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Which ADS-B source to try first: airplaneslive | opensky
ADSB_PRIMARY=airplaneslive

# ---------- Background tracking ----------
# Secret for GET /api/cron/poll (call it every 5 minutes with "Authorization: Bearer $CRON_SECRET").
CRON_SECRET=
# On a long-running server (Fly.io, Docker, `npm start`), poll in-process every 2 minutes instead.
INTERNAL_CRON=false

# ---------- Storage ----------
# gridfs (default; files in MongoDB, works on serverless) or local (writes to UPLOAD_DIR)
STORAGE_DRIVER=gridfs
UPLOAD_DIR=./uploads
# Per-file upload limit in MB (Vercel's request limit is about 4.5 MB; use Fly.io or similar for full-size photos)
MAX_UPLOAD_MB=10
NEXT_PUBLIC_MAX_UPLOAD_MB=10

# ---------- AI assist (optional) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------- Demo ----------
# Shows the "Demo replay" button (a stored delayed flight replayed ~90x faster, always labelled).
# Set to false to hide it for a public launch.
DEMO_MODE=true
SEED_PASSWORD=claimwing-demo-2026

# ---------- Flight Ripple ----------
# Trained delay model (produced by `npm run ml:train`). Leave unset to use data/models/ripple-model.json.
# RIPPLE_MODEL_PATH=
# Set to true to turn the trained model off (Flight Ripple then uses its labelled rule-based estimate).
# RIPPLE_MODEL_DISABLED=false

# ---------- Misc ----------
# Shown on the privacy page
CONTACT_EMAIL=
# Map tiles (default: CARTO basemaps, attribution included). {theme} becomes light or dark.
# NEXT_PUBLIC_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/{theme}_all/{z}/{x}/{y}{r}.png
