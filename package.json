    "ml:test": "cd ml && python3 -m pytest tests -q",
    "check:text": "node scripts/check-em-dash.mjs",
    "db:indexes": "tsx --conditions=react-server scripts/sync-indexes.ts",
    "test:e2e": "node tests/e2e/ripple.e2e.mjs"
  },
